# Cache lifetimes tiered by how often each thing actually changes.
# index.html/login.html stay uncached -- they're the session-gated entry
# points and must always be fresh.

# app.js/styles.css are still under active, frequent iteration -- a long
# cache here would mean people stuck on stale code for a while after
# every push. Short cache still meaningfully cuts request count for
# repeat loads/tab-reopens within a few minutes, without that risk.
/app.js
  Cache-Control: public, max-age=300, must-revalidate

/styles.css
  Cache-Control: public, max-age=300, must-revalidate

# Images and the traced map/route data only change on a rare, explicit
# request (a new patrol trace, a recolored crest, etc.) -- safe to cache
# far longer, which is where most of the actual request-count reduction
# comes from, since these are the largest and most frequently re-loaded
# static files.
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate