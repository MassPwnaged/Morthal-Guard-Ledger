{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morthal-guard-ledger",
  "compatibility_date": "2026-09-18",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "CLOCKINS", "id": "PASTE_YOUR_NAMESPACE_ID_HERE" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_STATE", "class_name": "LiveState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveState"] }
  ],
  "observability": { "enabled": true }
}
