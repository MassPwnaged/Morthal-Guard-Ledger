{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morthal-guard-ledger",
  "compatibility_date": "2026-09-18",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "CLOCKINS", "id": "e60f3f6e063644af8b35f442cd0d5e14" }
  ]
}