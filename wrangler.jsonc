{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morthal-guard-ledger",
  "compatibility_date": "2026-09-18",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}